# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Model provider: openai | anthropic | ollama ---
MODEL_PROVIDER=openai
MODEL=gpt-4o
OPENAI_API_KEY=sk-...

# For MODEL_PROVIDER=anthropic (also: uv add "autogen-ext[anthropic]==0.7.5")
# ANTHROPIC_API_KEY=
# For MODEL_PROVIDER=ollama (also: uv add "autogen-ext[ollama]==0.7.5"); model must support tool calling
# OLLAMA_HOST=http://localhost:11434

# --- Cost tracking: USD per 1M tokens (defaults are gpt-4o list prices; update for your model) ---
PRICE_INPUT_PER_MTOK=2.50
PRICE_OUTPUT_PER_MTOK=10.00

# --- Spend safeguards (an audit stops at whichever limit is hit first) ---
# MAX_TOKENS_PER_AUDIT=150000
# AUDIT_TIMEOUT_S=300
# MAX_REPLY_TOKENS=2048
# REQUEST_TIMEOUT_S=60

# --- Optional overrides ---
# BASELINE_PATH=baselines/cisco_ios_v1.yaml
# MAX_MESSAGES=25
# REPORTS_DIR=reports
# REMEDIATION_DIR=remediation
# LOGS_DIR=logs
# STATE_DIR=state
# Web UI: folder of configs offered in the picker (default tests/fixtures), and where uploads go
# CONFIGS_DIR=tests/fixtures
# UPLOADS_DIR=uploads
